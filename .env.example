# ---------- Général ----------
PORT=3000
BASE_URL=http://localhost:3000
# sandbox = clés sk_test_ + opérateurs simulés possibles ; live = production
PAY243_MODE=sandbox
# PostgreSQL — OBLIGATOIRE en live. Sans DATABASE_URL : moteur embarqué PGlite (développement uniquement)
# DATABASE_URL=postgres://pay243:motdepasse@localhost:5432/pay243
# DB_POOL_MAX=10
PGLITE_DIR=./data/pglite
# OBLIGATOIRE en production : chaînes aléatoires longues (ex: openssl rand -hex 32)
JWT_SECRET=change-me
CALLBACK_SECRET=change-me-too
# Délai de confirmation simulé (ms) pour les opérateurs "mock"
MOCK_DELAY_MS=3000

# ---------- Change & frais ----------
# Taux USD -> CDF (à synchroniser quotidiennement avec le taux indicatif BCC)
FX_USD_CDF=2850
FX_SPREAD_PERCENT=1
FEE_MERCHANT_PERCENT=2.5
FEE_WITHDRAWAL_PERCENT=1

# ---------- Pilotes opérateurs : mock | mpesa | airtel | aggregator ----------
MPESA_DRIVER=mock
AIRTEL_DRIVER=mock
ORANGE_DRIVER=mock

# Vodacom M-Pesa Open API (marché vodacomDRC)
MPESA_ENV=sandbox
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=

# Airtel Africa Open API (X-Country: CD)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# PIN de décaissement chiffré fourni par Airtel (pour les retraits)
AIRTEL_DISBURSEMENT_PIN=

# Agrégateur multi-opérateurs (API de type pawaPay) — utile pour Orange Money RDC
AGGREGATOR_BASE_URL=https://api.sandbox.pawapay.io
AGGREGATOR_API_TOKEN=

# ---------- Cartes : mock (sandbox) | à brancher sur votre acquéreur ----------
CARDS_DRIVER=mock

# ---------- Emails : mock (rien n'est envoyé, code affiché à l'écran) | resend (envoi réel) ----------
EMAIL_DRIVER=mock
EMAIL_FROM=Pay243 <no-reply@pay243.com>
# Adresse de réponse (facultatif), ex. support@pay243.com
EMAIL_REPLY_TO=
RESEND_API_KEY=

# ---------- SMS (codes pour les comptes sans email) : mock | africastalking ----------
SMS_DRIVER=mock
# Africa's Talking : username "sandbox" pour l'environnement de test
AT_USERNAME=sandbox
AT_API_KEY=
# Expéditeur alphanumérique validé (ex. PAY243)
AT_SENDER_ID=

# ---------- Rapprochement ----------
# RECON_SWEEP_INTERVAL_MS=300000          # contrôle des transactions en attente
# RECON_COLLECTION_EXPIRE_MINUTES=30      # encaissement sans réponse -> échec + écart
# RECON_PAYOUT_ALERT_MINUTES=60           # décaissement bloqué -> écart (jamais restitué d'office)
# RECON_TZ_OFFSET_MINUTES=60              # journée comptable à l'heure de Kinshasa

# ---------- KYC & back-office ----------
# OBLIGATOIRE en live : clé de chiffrement des pièces d'identité (openssl rand -hex 32)
KYC_ENCRYPTION_KEY=
# Dossier des pièces chiffrées (par défaut : <dossier de la base>/kyc)
# KYC_STORAGE_DIR=./data/kyc
# OBLIGATOIRE en live : une clé par agent, format nom:clé (24 caractères min.)
# ADMIN_KEYS=grace:xxxxxxxxxxxxxxxxxxxxxxxx,patrick:yyyyyyyyyyyyyyyyyyyyyyyy

# Bloque aussi en sandbox les webhooks vers des adresses internes (toujours actif en live)
# WEBHOOK_BLOCK_PRIVATE=1
